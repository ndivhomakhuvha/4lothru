{
  "name": "test-guide",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "postinstall": "pnpm --filter @test-guide/guide-schema build && pnpm --filter @test-guide/sdk build",
    "dev": "concurrently -k -n viewer,demo -c blue,green \"pnpm --filter @test-guide/viewer dev\" \"pnpm --filter @test-guide/demo-app dev\"",
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "guides:validate": "node packages/cli/bin/test-guide.js validate",
    "guides:build": "node packages/cli/bin/test-guide.js build",
    "guides:preview": "node packages/cli/bin/test-guide.js preview",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "^20.14.15",
    "concurrently": "^8.2.2",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
