{
  "name": "trail",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.1.0",
  "scripts": {
    "postinstall": "pnpm --filter @trail-cli/guide-schema build && pnpm --filter @trail-cli/sdk build",
    "dev": "concurrently -k -n schema,sdk,viewer,demo -c yellow,magenta,blue,green \"pnpm --filter @trail-cli/guide-schema dev\" \"pnpm --filter @trail-cli/sdk dev\" \"pnpm --filter @trail-cli/viewer dev\" \"pnpm --filter @trail-cli/demo-app dev\"",
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "predev": "pnpm --filter @trail-cli/guide-schema build && pnpm --filter @trail-cli/sdk build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "guides:validate": "node packages/cli/bin/trail.js validate",
    "guides:build": "node packages/cli/bin/trail.js build",
    "guides:preview": "node packages/cli/bin/trail.js preview",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@changesets/cli": "^2.29.8",
    "@types/node": "^20.14.15",
    "concurrently": "^8.2.2",
    "jsdom": "^24.1.3",
    "typescript": "^5.5.4",
    "vitest": "^2.1.9"
  }
}
