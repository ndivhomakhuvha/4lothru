{
  "name": "4lothru",
  "version": "0.1.0",
  "description": "Manual testing guides for your application",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndivhomakhuvha/4lothru.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "4lothru": "./bin/4lothru.js"
  },
  "files": ["bin", "dist"],
  "scripts": {
    "build": "pnpm --filter @4lothru/sdk exec tsup --config ../4lothru/tsup.config.ts",
    "dev": "pnpm --filter @4lothru/sdk exec tsup --watch --config ../4lothru/tsup.config.ts"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  }
}
